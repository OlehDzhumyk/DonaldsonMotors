meta {
  name: Create New Supplier
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/Suppliers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Bruno Test Supplier Ltd",
    "addressLine1": "1 Test Street",
    "postcode": "TEST1NG",
    "telephone": "01234567890",
    "email": "supplier@bruno-test.com"
  }
}

assert {
  res.status: eq 201
  res.body.name: eq "Bruno Test Supplier Ltd"
  res.body.id: isDefined
}

script:post-response {
  const responseBody = res.getBody();
  if (responseBody && responseBody.id) {
    bru.setEnvVar("createdSupplierId", responseBody.id);
    console.log("Set createdSupplierId to: " + responseBody.id);
  }
}
