meta {
  name: Get Supplier By ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/Suppliers/{{createdSupplierId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.id: eq {{createdSupplierId}}
  res.body.name: eq "Bruno Test Supplier Ltd"
}
