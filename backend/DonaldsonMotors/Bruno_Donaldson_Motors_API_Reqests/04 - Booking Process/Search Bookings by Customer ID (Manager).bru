meta {
  name: Search Bookings by Customer ID (Manager)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/Bookings/search?customerId={{customerId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body.every(b => b.customerId == {{customerId}}): eq true
}
