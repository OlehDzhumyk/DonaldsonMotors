meta {
  name: Create Booking
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/Bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "vehicleRegistrationNumber": "{{testVehicleReg}}",
    "serviceTypeId": "{{targetServiceTypeId}}", // ID типу послуги, наприклад, 1 для "Oil Change"
    "slotStart": "{{availableSlot}}" // Використовуємо змінну, встановлену попереднім запитом
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  const responseBody = res.getBody();
  if (responseBody && responseBody.id) {
    bru.setEnvVar("createdBookingId", responseBody.id);
  }
}
