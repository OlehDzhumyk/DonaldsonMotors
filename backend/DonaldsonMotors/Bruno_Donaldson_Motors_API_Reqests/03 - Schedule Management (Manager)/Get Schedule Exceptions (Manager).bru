meta {
  name: Get Schedule Exceptions (Manager)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/Schedule/exceptions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 201
  res.body.description: contains Christmas Day (Closed)
}

script:post-response {
  const responseBody = res.getBody();
    if (responseBody && responseBody.id) {
      bru.setEnvVar("createdExceptionId", responseBody.id);
    }
}
