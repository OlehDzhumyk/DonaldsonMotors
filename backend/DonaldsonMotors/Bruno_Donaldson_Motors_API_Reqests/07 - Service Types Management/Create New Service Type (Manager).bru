meta {
  name: Create New Service Type (Manager)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/ServiceTypes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "{{testServiceTypeName}}",
    "description": "Premium oil change with full synthetic oil and filter.",
    "price": 75.99,
    "durationHours": 1.5
  }
}

assert {
  res.status: eq 201 // Created
  res.body.name: eq "{{testServiceTypeName}}"
  res.body.id: isDefined
}

script:post-response {
  const responseBody = res.getBody();
  if (responseBody && responseBody.id) {
    bru.setEnvVar("createdServiceTypeId", responseBody.id);
    console.log("Set createdServiceTypeId to: " + responseBody.id);
  }
}
