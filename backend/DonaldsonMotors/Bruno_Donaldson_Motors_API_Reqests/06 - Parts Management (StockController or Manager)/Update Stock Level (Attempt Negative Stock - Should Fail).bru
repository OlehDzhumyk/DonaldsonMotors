meta {
  name: Update Stock Level (Attempt Negative Stock - Should Fail)
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/Parts/{{createdPartId}}/stock
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "changeInQuantity": -1000
  }
}

assert {
  res.status: eq 400
}
