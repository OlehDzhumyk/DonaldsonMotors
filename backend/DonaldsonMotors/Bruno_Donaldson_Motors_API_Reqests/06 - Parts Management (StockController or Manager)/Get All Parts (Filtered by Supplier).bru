meta {
  name: Get All Parts (Filtered by Supplier)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/Parts?supplierId={{createdSupplierId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body.every(p => p.supplierId == {{createdSupplierId}}): eq true
}
