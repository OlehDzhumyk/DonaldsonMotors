meta {
  name: Update Part
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/Parts/{{createdPartId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..UIeOw_PFKP8qTMBHvewtn34FDj1-6T61S7vPNXrYgJM
}

body:json {
  {
