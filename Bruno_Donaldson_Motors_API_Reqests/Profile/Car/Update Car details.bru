meta {
  name: Update Car details
  type: http
  seq: 1
}

put {
  url: {{baseURL}}/Users/me/cars/{{testVehicleRegistration}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
      "registration": "TEST123A",
      "make": "Ford",
      "model": "Focus ST",
      "year": 2021 
  }
}
