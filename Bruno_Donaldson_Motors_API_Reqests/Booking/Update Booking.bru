meta {
  name: Update Booking
  type: http
  seq: 4
}

put {
  url: {{baseURL}}Bookings/:latestBookingId
  body: json
  auth: bearer
}

params:path {
  latestBookingId: {{latestBookingId}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "bookingDate": "2025-06-05T14:30:00",
    "status": "Confirmed",
    "vehicleRegistration": "AB12CDE"
  }
}
