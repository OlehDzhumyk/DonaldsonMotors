meta {
  name: Add Vehicle to My Profile
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/users/me/cars/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "registrationNumber": "{{testVehicleReg}}",
    "make": "TestMake",
    "model": "TestModel",
    "year": 2022,
    "mileage": 12345
  }
}

assert {
  res.status: eq 201
  res.body.registrationNumber: eq "{{testVehicleReg}}"
}
