# Optional: copy to .env to override the defaults in docker-compose.yml.
# Without a .env file the app runs with local-only development values.

ASPNETCORE_ENVIRONMENT=Development
DB_CONN=Host=db;Port=5432;Database=donaldson;Username=dm_user;Password=dm_pass

# Use a long random value anywhere other than your own machine
JWT_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=http://localhost:5000
JWT_EXPIRYMINUTES=60

# Demo accounts, cars and bookings (see README)
SEED_DEMO_DATA=true

# By default emails go to Mailpit (http://localhost:8025). To send real email, set your SMTP provider here.
EmailSettings__SmtpHost=mailpit
EmailSettings__SmtpPort=1025
EmailSettings__SmtpUser=
EmailSettings__SmtpPass=
EmailSettings__UseSsl=false
EmailSettings__FromName=Donaldson Motors
EmailSettings__FromAddress=noreply@donaldsonmotors.local
EmailSettings__WebsiteUrl=http://localhost:3000
