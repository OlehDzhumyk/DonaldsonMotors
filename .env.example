ASPNETCORE_ENVIRONMENT=Development

# Database Connection
DB_CONN=Host=db;Port=5432;Database=donaldson;Username=dm_user;Password=dm_pass

# JWT settings
JWT_KEY=your_production_or_staging_jwt_secret_key_that_is_very_long_and_secure
JWT_ISSUER=https://your-production-api-domain.com 
JWT_AUDIENCE=https://your-production-client-domain.com
JWT_EXPIRYMINUTES=60

# Application User ID for Docker (if needed, often 1000 or same as host user)
APP_UID=1000 

# Email Settings
EmailSettings__SmtpHost=your_actual_smtp_host_from_email_provider
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser=your_actual_smtp_username_or_apikey
EmailSettings__SmtpPass=your_actual_smtp_password_or_apikey
EmailSettings__FromName=Donaldson Motors
EmailSettings__FromAddress=noreply@youractualdomain.com
EmailSettings__WebsiteUrl=https://your-production-client-domain.com